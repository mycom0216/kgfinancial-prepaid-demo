# 복사한 뒤 안전한 긴 값을 넣으세요. 이 파일은 Git에 올리지 마세요.
DATABASE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
# 아래는 KG이니시스 테스트 가맹점에서 받은 값을 사용해요. 실키를 Git에 올리지 마세요.
INICIS_MODE=staging
INICIS_MID=REPLACE_WITH_TEST_MID
INICIS_HASH_KEY=REPLACE_WITH_TEST_HASH_KEY
# 결제 결과 주소는 외부에서 접속되는 HTTPS 도메인이어야 해요. 예: https://demo.example.com
APP_PUBLIC_URL=https://REPLACE_WITH_YOUR_HTTPS_DOMAIN

